<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple Privacy Manifest. REQUIRED for App Store upload since May 2024 (hard reject otherwise).
  Declares the "required-reason APIs" the appwrap shell + NativeScript runtime touch, none of which
  are used for tracking:
    - UserDefaults (CA92.1)   — kit.storage / ApplicationSettings (NSUserDefaults)
    - FileTimestamp (C617.1)  — NativeScript reads bundle/app file metadata at runtime
    - SystemBootTime (35F9.1) — NativeScript timers/uptime
    - DiskSpace (E174.1)      — NativeScript file I/O
  NSPrivacyTracking is false (no IDFA, no cross-app/third-party linkage) and NSPrivacyCollectedDataTypes
  is EMPTY by default: the stock runtime does NOT collect or transmit any data. kit.context() merely
  RETURNS install context (IDFV, platform, version) to the app on request — it never sends it anywhere —
  so the default binary matches a "Data Not Collected" App Store privacy label.

  If YOUR app wires analytics that actually transmits data (DeviceID/IDFV, ProductInteraction, account,
  location, …) you MUST declare it here — replace this whole file via your app's overrides dir
  (appwrap.overrides/App_Resources/iOS/PrivacyInfo.xcprivacy). `applyOverrides` copies overrides over
  the generated native/ last, so your file wins. Add the matching NSPrivacyCollectedDataTypes entries
  (and set NSPrivacyTracking=true if you track) — see tracking-analytics + store-readiness.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
